defaults: &defaults
  # host: 'the hostname to use for static asset cdn, eg: https://mydistribution.cloudfront.net'
  # region: us-east-1
  # bucket: "name of the s3 bucket to push things to"
  # aws_access_key_id: "secret aws_access_key_id that has write access to that bucket"
  # aws_secret_access_key: "secret_access_key for that access_key_id"
  # endpoint: "override for S3-compatible backends other than AWS, eg Cloudflare R2:
  #             https://<account_id>.r2.cloudflarestorage.com (region: auto). See
  #             notes/canvas-fork-estrategia.md in frative-docs for context."

development:
  <<: *defaults

test:
  <<: *defaults

production:
  <<: *defaults
